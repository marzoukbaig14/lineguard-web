# LineGuard website — public (client-side) configuration.
# Copy to `.env.local` and fill in. Nothing secret belongs here: every value is
# shipped to the browser (NEXT_PUBLIC_*).

# Formspree project ID for the contact form. When unset, the form renders a
# clearly-marked placeholder instead of a live form.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional: cinematic hero background video (muted, looped) + poster still.
# When unset, the hero falls back to the designed placeholder.
NEXT_PUBLIC_HERO_VIDEO=
NEXT_PUBLIC_HERO_POSTER=
